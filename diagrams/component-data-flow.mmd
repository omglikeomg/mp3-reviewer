%% Component Data Flow — MVU Pipeline, tea.Cmd / tea.Msg Flows, Component Interactions
%% Source of truth: the actual Go source code (internal/tui/, internal/audio/, etc.).
%%
%% Updated after Task 5: enrichment features (MusicBrainz year/BPM fetch, tap-tempo,
%% Ctrl+1/Ctrl+2 commit, spinner, WriteBPM, WriteYear) are now implemented.

flowchart TD
    %% ================================================================
    %% MVU CYCLE
    %% ================================================================
    subgraph MVU["Bubble Tea MVU Cycle"]
        direction TB
        Init["Init\nReturns pendingInit\ntea.Batch: tickCmd + spinnerTick\n+ playCmd + fetchYearCmd + fetchBPMCmd"]
        Update["Update msg tea.Msg\nDispatches on msg type\nReturns Model, tea.Cmd"]
        View["View\nPure rendering function\nReads only from Model fields\nNo side effects"]
        Render["Terminal Render\nPrints View output"]

        Init -->|"pendingInit Cmd batch"| Update
        Update -->|"updated Model"| View
        View --> Render
        Render -->|"wait for next msg"| Update
    end

    %% ================================================================
    %% MESSAGE TYPES AND DISPATCH
    %% ================================================================
    subgraph Messages["tea.Msg Types"]
        TickMsg["TickMsg\ntime.Time"]
        SpinnerTickMsg["spinner.TickMsg\nfrom bubbles/spinner"]
        PlayErrMsg["PlayErrMsg\nErr: error"]
        TagWrittenMsg["TagWrittenMsg\nPrimary: string\nSecondary: string\nErr: error"]
        SaveStateErrMsg["SaveStateErrMsg\nErr: error"]
        YearFetchedMsg["YearFetchedMsg\nYear: string\nErr: error"]
        BPMFetchedMsg["BPMFetchedMsg\nBPM: string\nErr: error"]
        BPMWrittenMsg["BPMWrittenMsg\nBPM: string\nErr: error"]
        YearWrittenMsg["YearWrittenMsg\nYear: string\nErr: error"]
        KeyMsg["tea.KeyMsg\nkeyboard input"]
        WindowSizeMsg["tea.WindowSizeMsg\nWidth, Height"]
    end

    %% ================================================================
    %% CMD FACTORIES
    %% ================================================================
    subgraph Commands["tea.Cmd Factories"]
        tickCmd["tickCmd\ntea.Tick 100ms\nReturns TickMsg"]
        playCmd["playCmd engine, path\nCalls engine.Play\nReturns PlayErrMsg"]
        writeTagsCmd["writeTagsCmd path, pri, sec\nCalls metadata.WriteTags\nReturns TagWrittenMsg"]
        saveStateCmd["saveStateCmd provider, tasks\nCalls provider.SaveState\nReturns SaveStateErrMsg"]
        fetchYearCmd["fetchYearCmd artist, title, ua\nCalls api.FetchYear\nReturns YearFetchedMsg"]
        fetchBPMCmd["fetchBPMCmd artist, title, ua\nCalls api.FetchBPM\nReturns BPMFetchedMsg"]
        writeBPMCmd["writeBPMCmd path, bpm\nCalls metadata.WriteBPM\nReturns BPMWrittenMsg"]
        writeYearCmd["writeYearCmd path, year\nCalls metadata.WriteYear\nReturns YearWrittenMsg"]
    end

    %% ================================================================
    %% EXTERNAL COMPONENTS
    %% ================================================================
    subgraph External["External Components"]
        Engine["audio.Engine\n- Play path: error\n- Seek delta: error\n- TogglePause\n- GetState: PlaybackState\n- Close"]
        MetadataWriter["metadata\n- WriteTags: TCON + TXXX frames\n- WriteBPM: TBPM frame\n- WriteYear: TYER/TDRC frame"]
        Provider["provider.ManualReviewProvider\n- SaveState tasks: error\n- Atomic JSON write\n- Persists genres, BPM, year"]
        MusicBrainzAPI["api.MusicBrainz\n- FetchYear: recording search\n  inc=release-groups+tags\n  earliest first-release-date\n- FetchBPM: check user tags\n  for numeric BPM values"]
    end

    %% ================================================================
    %% SELF-PERPETUATING TICKER CYCLE
    %% ================================================================
    subgraph TickerCycle["Self-Perpetuating Ticker"]
        direction LR
        T1["tickCmd"] -->|"after 100ms"| T2["TickMsg delivered"]
        T2 -->|"Update handler"| T3["engine.GetState\ncache PlaybackState"]
        T3 -->|"returns new"| T1
    end

    %% ================================================================
    %% ENRICHMENT FLOW
    %% ================================================================
    subgraph EnrichmentFlow["Enrichment Data Flow"]
        direction TB
        SongLoad["Song loads\nskipToNext or undoLast or Init"]
        ResetEnrich["resetEnrichment\nclear Year/BPM status and values\nclear tapTimes"]
        FireFetches["Fire fetchYearCmd + fetchBPMCmd\nif Artist or Title non-empty\nset enrichYearStatus = enrichLoading\nset enrichBPMStatus = enrichLoading"]

        YearResult{"YearFetchedMsg"}
        YearFound["enrichYearStatus = enrichFound\nenrichYearValue = year string"]
        YearNotFound["enrichYearStatus = enrichIdle\nnot found or error"]

        BPMResult{"BPMFetchedMsg"}
        BPMFound["enrichBPMStatus = enrichFound\nenrichBPMValue = bpm string\nfrom MusicBrainz tag"]
        BPMNotFound["enrichBPMStatus = enrichIdle\nfallback to Tap Tempo"]

        TapTempoFlow["Tap Tempo via t key\nrecordTap appends timestamp\nisTappingIrregular checks deviation\n8 taps required for BPM calc\nstale gap 3s resets sequence\nirregular >40% resets sequence"]
        TapResult["enrichBPMStatus = enrichFound\nenrichBPMValue = calculated BPM"]

        CommitBPM["Ctrl+1\nif enrichBPMStatus == enrichFound\nfire writeBPMCmd"]
        CommitYear["Ctrl+2\nif enrichYearStatus == enrichFound\nfire writeYearCmd"]

        BPMCommitted["BPMWrittenMsg\nenrichBPMStatus = enrichCommitted\ntask.BPM updated\nfire saveStateCmd"]
        YearCommitted["YearWrittenMsg\nenrichYearStatus = enrichCommitted\ntask.Year updated\nfire saveStateCmd"]

        SongLoad --> ResetEnrich
        ResetEnrich --> FireFetches

        FireFetches --> YearResult
        YearResult -->|"year found"| YearFound
        YearResult -->|"not found or error"| YearNotFound

        FireFetches --> BPMResult
        BPMResult -->|"BPM found in tags"| BPMFound
        BPMResult -->|"not found"| BPMNotFound

        BPMNotFound --> TapTempoFlow
        TapTempoFlow -->|"8+ taps collected"| TapResult

        YearFound --> CommitYear
        BPMFound --> CommitBPM
        TapResult --> CommitBPM

        CommitBPM --> BPMCommitted
        CommitYear --> YearCommitted
    end

    %% ================================================================
    %% KEY PRESS ROUTING
    %% ================================================================
    subgraph KeyRouting["Key Press Routing via handleKey"]
        direction TB
        KeyDispatch{"Check m.state"}

        subgraph ReviewingKeys["StateReviewing Keys"]
            KLeft["Left arrow\nengine.Seek neg seekDelta"]
            KRight["Right arrow\nengine.Seek pos seekDelta"]
            KPause["p key\nengine.TogglePause"]
            KEnterTag["Enter or Space\nopenGenreModal"]
            KEscSkip["Esc\nskipToNext + resetEnrichment"]
            KUndo["Ctrl+U\nundoLast + resetEnrichment"]
            KTap["t key\nrecordTap\ntap-tempo BPM"]
            KCommitBPM["Ctrl+1\ncommit BPM via writeBPMCmd"]
            KCommitYear["Ctrl+2\ncommit Year via writeYearCmd"]
            KQuit1["Ctrl+C\nengine.Close + tea.Quit"]
        end

        subgraph GenreKeys["StateGenreSelection Keys"]
            GEnter["Enter\nconfirmGenreSelection"]
            GEsc["Esc\nCancel modal\nstate = StateReviewing"]
            GQuit["Ctrl+C\nengine.Close + tea.Quit"]
            GDelegate["Other keys\nDelegate to bubbles list\narrow keys, filter typing"]
        end

        KeyDispatch -->|"StateReviewing"| ReviewingKeys
        KeyDispatch -->|"StateGenreSelection"| GenreKeys
    end

    %% ================================================================
    %% GENRE SELECTION TWO-STEP DATA FLOW
    %% ================================================================
    subgraph GenreFlow["Genre Selection Data Flow"]
        direction TB
        G1["Enter or Space in StateReviewing"]
        G2["openGenreModal\nstate = StateGenreSelection\ngenreStep = stepPrimary\nbuild list without NONE"]
        G3["User browses and filters\nbubbles list handles navigation"]
        G4["Enter on primary item\nselectedPrimary = choice\ngenreStep = stepSecondary\nrebuild list with NONE prepended"]
        G5["User browses Step 2 list"]
        G6["Enter on secondary item\nconfirmGenreSelection"]
        G7["secondary = choice or empty if NONE\nstate = StateReviewing"]
        G8["writeTagsCmd path, primary, secondary"]
        G9["TagWrittenMsg returned"]
        G10{"TagWrittenMsg.Err?"}
        G11["Err not nil\nSet lastPlayErr\nStay in StateReviewing"]
        G12["Err is nil\nUpdate task Genre1 and Genre2\nFire saveStateCmd"]
        G13["skipToNext + resetEnrichment\nPush current to History\nCurrentIndex++\nplayCmd + fetchYearCmd + fetchBPMCmd"]
        G14["SaveStateErrMsg returned\nShow in status bar if err"]

        G1 --> G2
        G2 --> G3
        G3 --> G4
        G4 --> G5
        G5 --> G6
        G6 --> G7
        G7 --> G8
        G8 --> G9
        G9 --> G10
        G10 -->|"error"| G11
        G10 -->|"success"| G12
        G12 --> G13
        G12 --> G14
    end

    %% ================================================================
    %% MSG to UPDATE HANDLER CONNECTIONS
    %% ================================================================
    TickMsg -->|"handler: cache GetState, return tickCmd"| Update
    SpinnerTickMsg -->|"handler: advance spinner, return spinCmd"| Update
    PlayErrMsg -->|"handler: set lastPlayErr"| Update
    TagWrittenMsg -->|"handler: update task or show error, fire saveStateCmd + skipToNext"| Update
    SaveStateErrMsg -->|"handler: set lastSaveErr"| Update
    YearFetchedMsg -->|"handler: set enrichYearStatus + enrichYearValue"| Update
    BPMFetchedMsg -->|"handler: set enrichBPMStatus + enrichBPMValue or fallback to tap tempo"| Update
    BPMWrittenMsg -->|"handler: set enrichBPMStatus = committed, update task.BPM, fire saveStateCmd"| Update
    YearWrittenMsg -->|"handler: set enrichYearStatus = committed, update task.Year, fire saveStateCmd"| Update
    KeyMsg -->|"handler: handleKey dispatch"| Update
    WindowSizeMsg -->|"handler: update width height, resize progress bar"| Update

    %% ================================================================
    %% CMD to EXTERNAL COMPONENT CONNECTIONS
    %% ================================================================
    playCmd -->|"engine.Play path"| Engine
    Engine -->|"error or nil"| PlayErrMsg
    writeTagsCmd -->|"metadata.WriteTags"| MetadataWriter
    MetadataWriter -->|"error or nil"| TagWrittenMsg
    writeBPMCmd -->|"metadata.WriteBPM"| MetadataWriter
    MetadataWriter -->|"error or nil"| BPMWrittenMsg
    writeYearCmd -->|"metadata.WriteYear"| MetadataWriter
    MetadataWriter -->|"error or nil"| YearWrittenMsg
    saveStateCmd -->|"provider.SaveState"| Provider
    Provider -->|"error or nil"| SaveStateErrMsg
    fetchYearCmd -->|"api.FetchYear"| MusicBrainzAPI
    MusicBrainzAPI -->|"year string or error"| YearFetchedMsg
    fetchBPMCmd -->|"api.FetchBPM"| MusicBrainzAPI
    MusicBrainzAPI -->|"bpm string or error"| BPMFetchedMsg
    tickCmd -->|"tea.Tick 100ms"| TickMsg

    %% ================================================================
    %% DIRECT SYNCHRONOUS CALLS IN UPDATE (non-Cmd, fast, non-blocking)
    %% ================================================================
    KLeft -->|"direct call"| Engine
    KRight -->|"direct call"| Engine
    KPause -->|"direct call"| Engine
    KQuit1 -->|"engine.Close"| Engine

    %% ================================================================
    %% VIEW READS FROM MODEL ONLY
    %% ================================================================
    View -->|"reads m.playbackState, m.queue,\nm.state, m.lastPlayErr,\nm.lastSaveErr, m.genreList,\nm.genreStep, m.selectedPrimary,\nm.enrichYearStatus, m.enrichYearValue,\nm.enrichBPMStatus, m.enrichBPMValue,\nm.tapTimes, m.spinner"| ModelState["Cached Model Fields\nno external calls"]
